	(text "Three independent sockets, one per channel.\n\nPinout is imported from the module's own MEZZ_PINS, not retyped -\na base board whose pin 17 disagrees with the module's pin 17\ndestroys a module on first power-up.\n\nEvery net here is prefixed A_, B_ or C_. The unprefixed ones are\nGND only. Anything else shared between channels would be a\ncommon-cause failure path."
		(at 21.59 13.97 0)
		(effects
			(font
				(size 1.4 1.4)
			)
			(justify left top)
		)
		(uuid "b40e3594-9463-48f7-8b4d-da536573c63e")
	)
