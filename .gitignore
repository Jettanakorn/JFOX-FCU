# Rust
/target
**/*.rs.bk
Cargo.lock

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Debug
*.elf
*.bin
*.hex
*.px4

# Python (hardware/tools)
__pycache__/
*.pyc

# KiCad local/derived state (hardware/)
*.kicad_prl
*-backups/
fp-info-cache
~*.lck
# KiCad 10's Local History feature keeps its own nested git repo here, which
# would otherwise be committed as a broken submodule.
.history/

# DRC/ERC reports are generated on demand
*-drc.rpt
*-erc.rpt

# KiCad byproducts of `pcb import` on the vendored board
hardware/vendor/*.kicad_pcb
hardware/vendor/*.kicad_pro
hardware/vendor/*.kicad_dru
hardware/vendor/*.png

# Vendor datasheets - fetched locally, not ours to redistribute
hardware/jfox-fmu-v1/datasheets/

# Loop search artefacts - regenerated by loop_fmu_layout.py on every run.
# The DRC report is a scratch file; the renders are a visual trail of one
# search, not a design input.
hardware/jfox-fmu-v1/render/
